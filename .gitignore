# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Vendored Stockfish NNUE networks — the Xcode build phase downloads these
# itself (curl, skipped if already present) from
# https://tests.stockfishchess.org/api/nn/, so they don't belong in git;
# the "big net" exceeds GitHub's 100MB file-size limit outright.
third_party/stockfish/**/*.nnue

# Node & Playwright network captures
node_modules/
package-lock.json
/captured_network/

# Claude Code: ephemeral per-session state, never shared project config
.claude/worktrees/
.claude/settings.local.json

# Vendored Dart/Flutter skills (dart-lang/skills, pinned in
# skills-lock.json) — CLAUDE.md documents keeping these two copies
# identical in git, but excluding them here per request; re-fetchable
# from skills-lock.json's recorded hashes if needed later.
.claude/skills/
.agents/skills/

# One-off scratch dumps (e.g. chunked text dumps for LLM processing) —
# never source, never meant to be committed.
lib_prompt_chunks_*/

